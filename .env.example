# Public URL of the deployed site (used for metadata, sitemap and robots).
NEXT_PUBLIC_SITE_URL=https://example.com

# Contact form (Resend). Without these, the form asks visitors to email directly.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
# Must be a sender on a domain verified in Resend.
CONTACT_FROM_EMAIL="Portfolio <hello@example.com>"
